# PitStop Assistant — secrets Streamlit Community Cloud (modèle)
# Copie ce fichier vers .streamlit/secrets.toml et remplis LES MÊMES clés
# dans Streamlit Cloud (Settings > Secrets) avec les vraies valeurs.
# Ne jamais commiter un secrets.toml rempli.
GROQ_API_KEY=""
GROQ_MODEL="llama-3.3-70b-versatile"

QDRANT_URL=""
QDRANT_API_KEY=""
QDRANT_COLLECTION_NAME="pitstop_docs"

SUPABASE_URL=""
SUPABASE_ANON_KEY=""

EMBEDDING_MODEL="BAAI/bge-small-en-v1.5"
FASTF1_CACHE_DIR=""

MLFLOW_TRACKING_URI=""
MLFLOW_TRACKING_USERNAME=""
MLFLOW_TRACKING_PASSWORD=""

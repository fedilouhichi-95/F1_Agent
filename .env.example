# PitStop Assistant — variables d'environnement
# Duplique ce fichier en `.env` (local) ou renseigne les Secrets Colab / secrets Streamlit
# Cloud avec les MÊMES noms. Ne commit JAMAIS un `.env` rempli.

# --- Groq (LLM) ---
# Clé API gratuite depuis console.groq.com. Modèle par défaut : llama-3.3-70b-versatile.
GROQ_API_KEY=

# --- Qdrant Cloud (RAG vectoriel) ---
# URL du cluster gratuit (ex: https://xxxxx.eu-central.aws.cloud.qdrant.io)
QDRANT_URL=
# Clé API Qdrant Cloud
QDRANT_API_KEY=
# Nom de la collection contenant les chunks textuels
QDRANT_COLLECTION_NAME=pitstop_docs

# --- Supabase (PostgreSQL hébergé) ---
# URL du projet (ex: https://xxxxx.supabase.co)
SUPABASE_URL=
# Clé API "anon" du projet (lecture via RLS ; écritures réservées au rôle de service)
SUPABASE_ANON_KEY=
# Connexion PostgreSQL : copier la chaîne depuis Project Settings > Database > Connect,
# onglet "Session pooler". L'hôte aws-N.pooler.supabase.com ne se déduit PAS de la
# région (N est un index de cluster) : le saisir à la main produit une erreur
# "tenant/user ... not found". La connexion directe est IPv6-only et échoue depuis Colab.
SUPABASE_DB_URL=
# Mot de passe de la base (transmis séparément par psycopg2, donc inutile dans l'URL)
SUPABASE_DB_PASSWORD=

# --- MLflow / DagsHub (tracking des expériences) ---
# URI MLflow fournie par DagsHub (ex: https://dagshub.com/<user>/<repo>.mlflow)
MLFLOW_TRACKING_URI=
# Identifiants DagsHub (username + mot de passe/token)
MLFLOW_TRACKING_USERNAME=
MLFLOW_TRACKING_PASSWORD=

# --- Ingestion F1 ---
# Saisons à ingérer, séparées par des virgules (référencées par SPEC.md : 2023)
INGEST_SEASONS=2023
# Base de l'API Jolpica-F1 (successeur d'Ergast) : métadonnées et résultats
JOLPICA_BASE_URL=https://api.jolpi.ca/ergast/f1
# --- FastF1 (cache sur Google Drive en dev Colab) ---
# Chemin absolu du cache FastF1 (persistant entre sessions Colab)
FASTF1_CACHE_DIR=/content/drive/MyDrive/f1_cache

# --- Embeddings (modèle utilisé pour le RAG) ---
# Nom du modèle sentence-transformers
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# --- Production (Streamlit Cloud) ---
# Ces valeurs ne sont utilisées que dans .streamlit/secrets.toml côté Streamlit Cloud.
STREAMLIT_SERVER_ADDRESS=0.0.0.0
STREAMLIT_SERVER_PORT=8501